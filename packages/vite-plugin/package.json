{
  "name": "@change-spotlight/vite-plugin",
  "version": "0.1.1",
  "type": "module",
  "description": "Vite plugin for Change Spotlight: tags changed JSX elements and shows which ones you have seen.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rijja-Farhan/ChangeSpotlight.git",
    "directory": "packages/vite-plugin"
  },
  "scripts": {
    "build": "tsc -p .",
    "dev": "tsc -p . --watch",
    "typecheck": "tsc -p . --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@change-spotlight/core": "workspace:*",
    "magic-string": "^1.4.3",
    "oxc-parser": "^0.154.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@jridgewell/trace-mapping": "^0.3.31",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "playwright-core": "^1.64.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "vite": ">=4"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./bridge": {
      "types": "./dist/bridge.d.ts",
      "default": "./dist/bridge.js"
    },
    "./elements": {
      "types": "./dist/elements.d.ts",
      "default": "./dist/elements.js"
    }
  }
}
